# Copie este archivo como .env (en el servidor: /opt/consultor/.env) y complete los valores.
# Nunca lo suba al repositorio: tiene los usuarios y contraseñas.

# --- Acceso -----------------------------------------------------------------------------------
# Dominio con el que se entra (registro DNS tipo A apuntando a la IP del servidor).
DOMINIO=consultor.mifirma.com

# Usuarios de la interfaz, separados por comas. Genere cada uno con:
#   docker compose run --rm consultor consultor-procesos crear-usuario NOMBRE
# (o en su computador: .venv\Scripts\consultor-procesos crear-usuario NOMBRE) y pegue la línea.
# Cree también un usuario "monitor" para la revisión automática desde GitHub.
CONSULTOR_USUARIOS=

# --- Identificación ante la Rama Judicial (obligatorio) -----------------------------------------
# Correo al que el administrador del portal puede escribir antes de bloquear el acceso.
CONSULTOR_CONTACTO=sistemas@mifirma.com

# --- Proxy HTTPS ------------------------------------------------------------------------------
# Servidor solo para el Consultor: este proyecto trae su propio Caddy.
COMPOSE_PROFILES=proxy
# Servidor compartido con el Administrador de Procesos (su Caddy atiende los dos dominios):
# deje COMPOSE_PROFILES vacío y active estas dos líneas (ver docs/DESPLIEGUE.md, sección 3B).
# COMPOSE_FILE=docker-compose.yml:docker-compose.compartido.yml
# RED_PROXY=procesos_default

# Zona horaria: el horario de verificación (07:00 a 18:00) es hora de Colombia.
TZ=America/Bogota

# --- Aviso por correo (opcional; se activa en datos/consultor_procesos.toml) ------------------
CONSULTOR_SMTP_CONTRASENA=

# --- Lo escribe el despliegue automático; no lo edite a mano -------------------------------------
# CONSULTOR_IMAGEN=ghcr.io/juanlesmes/consultor-procesos-judiciales:sha-...
